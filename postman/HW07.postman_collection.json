		{
			"name": "Add-Product",
			"item": [
				{
					"name": "Add-Product",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"/// Get test case details from CSV iteration data\r",
									"let testCaseId = pm.iterationData.get(\"Test case ID\");\r",
									"let expectedResponse = pm.iterationData.get(\"Expected Response\");\r",
									"let expectedResult = pm.iterationData.get(\"Expected Result\");\r",
									"\r",
									"// Convert to lowercase for easier matching\r",
									"let expectedResultLower = expectedResult ? expectedResult.toLowerCase() : \"\";\r",
									"\r",
									"// Get actual response\r",
									"let statusCode = pm.response.code;\r",
									"let jsonData;\r",
									"try {\r",
									"    jsonData = pm.response.json();\r",
									"} catch (e) {\r",
									"    jsonData = {};\r",
									"}\r",
									"\r",
									"// Helper function to compare if response has all request fields\r",
									"function hasAllFieldsAsRequest() {\r",
									"    let requestData = {\r",
									"        name: pm.iterationData.get(\"Product Name\"),\r",
									"        description: pm.iterationData.get(\"Description\"),\r",
									"        stock: pm.iterationData.get(\"Stock\") !== \"\" ? Number(pm.iterationData.get(\"Stock\")) : null,\r",
									"        price: pm.iterationData.get(\"Price\") !== \"\" ? Number(pm.iterationData.get(\"Price\")) : null,\r",
									"        location_offer: pm.iterationData.get(\"Location Offer\") === \"true\",\r",
									"        item_for_rent: pm.iterationData.get(\"Item for Rent\") === \"true\",\r",
									"        brand_id: Number(pm.iterationData.get(\"Brand\")),\r",
									"        category_id: Number(pm.iterationData.get(\"Category\")),\r",
									"        image_id: Number(pm.iterationData.get(\"Image\"))\r",
									"    };\r",
									"\r",
									"    for (let key in requestData) {\r",
									"        if (requestData.hasOwnProperty(key)) {\r",
									"            let reqValue = requestData[key];\r",
									"            let resValue = jsonData[key];\r",
									"            if (String(reqValue).trim() !== String(resValue).trim()) {\r",
									"                console.log(`Field mismatch: ${key} | Expected: ${reqValue} | Got: ${resValue}`);\r",
									"                return false;\r",
									"            }\r",
									"        }\r",
									"    }\r",
									"    return true;\r",
									"}\r",
									"\r",
									"// Main test cases\r",
									"pm.test(`Test Case: ${testCaseId} - ${expectedResponse}`, function () {\r",
									"\r",
									"    // Special edge case PRT_ADD_00\r",
									"    if (testCaseId === \"PRT_ADD_00\") {\r",
									"        pm.expect(statusCode).to.eql(200); // [Inference] The provided script expects a 200 status for this case\r",
									"        pm.expect(hasAllFieldsAsRequest(), \"Response should have all fields matching request\").to.be.true;\r",
									"        return;\r",
									"    }\r",
									"\r",
									"    // Pass cases (Expected: Pass, Status Code: 201)\r",
									"    if (expectedResultLower === \"pass\" && statusCode === 201) {\r",
									"        pm.expect(true).to.be.true;\r",
									"        return;\r",
									"    }\r",
									"\r",
									"    // Fail cases (Expected: Fail, Status Code: 422 or 500)\r",
									"    if (expectedResultLower === \"fail\" && (statusCode === 422 || statusCode === 500)) {\r",
									"        pm.expect(true).to.be.true;\r",
									"        return;\r",
									"    }\r",
									"\r",
									"    // Anything else means failure\r",
									"    pm.expect.fail(`Unexpected result. Status: ${statusCode}, Expected: ${expectedResultLower}`);\r",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\r\n    \"id\": \"\",\r\n    \"name\": \"{{Product Name}}\",\r\n    \"description\": \"{{Description}}\",\r\n    \"stock\": \"{{Stock}}\",\r\n    \"price\": \"{{Price}}\",\r\n    \"brand_id\": \"{{Brand}}\",\r\n    \"category_id\": \"{{Category}}\",\r\n    \"product_image_id\": \"{{Image}}\",\r\n    \"is_location_offer\": {{Location Offer}},\r\n    \"is_rental\": {{Item for Rent}}\r\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/products",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"products"
							]
						}
					},
					"response": []
				}
			]
		},
